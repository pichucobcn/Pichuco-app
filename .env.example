DATABASE_URL="postgresql://postgres@localhost:5432/pichuco"
DIRECT_URL="postgresql://postgres@localhost:5432/pichuco"
# ANTHROPIC_API_KEY=sk-ant-...   (sin clave, Pichuco AI usa el intérprete local de demostración)
# PICHUCO_AI_MODEL=claude-sonnet-5-5   (o claude-opus-5-5 si hiciera falta más capacidad)
# PICHUCO_DEMO_OTP=1   (muestra el código OTP en pantalla; no usar en producción)
PICHUCO_DEMO_OTP=1
TZ_RESTAURANT="Europe/Madrid"
# Código que el equipo pone al entrar (protege la app mientras el login muestra el código en pantalla)
# PICHUCO_ACCESS_CODE=elegí-uno
