DATABASE_URL="postgresql://postgres@localhost:5432/pichuco"
# ANTHROPIC_API_KEY=sk-ant-...   (sin clave, Pichuco AI usa el intérprete local de demostración)
# PICHUCO_AI_MODEL=claude-opus-5-5
# PICHUCO_DEMO_OTP=1   (muestra el código OTP en pantalla; no usar en producción)
PICHUCO_DEMO_OTP=1
TZ_RESTAURANT="Europe/Madrid"
