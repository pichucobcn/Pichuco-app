DATABASE_URL="postgresql://postgres@localhost:5432/pichuco"
# ANTHROPIC_API_KEY=sk-ant-...   (sin clave, Pichuco AI usa el intérprete local de demostración)
# PICHUCO_AI_MODEL=claude-opus-5-5
# PICHUCO_DEMO_OTP=1   (muestra el código OTP en pantalla; no usar en producción)
PICHUCO_DEMO_OTP=1
TZ_RESTAURANT="Europe/Madrid"
# Pagos online: con STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET se usa Stripe Checkout.
# Sin Stripe, PICHUCO_DEMO_PAYMENTS=1 activa un pago simulado para probar.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
PICHUCO_DEMO_PAYMENTS=1
# URL pública (para los enlaces de pago). Si no, se usa la del navegador.
# PUBLIC_BASE_URL=https://app.pichuco.es
