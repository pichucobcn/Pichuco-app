generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  JEFE
  JEFE_COCINA
  COCINERO
  CAMARERA
}

enum Area {
  COCINA
  SALA
  ADMIN
  GENERAL
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  shortName   String
  role        Role
  area        Area     @default(GENERAL)
  avatarColor String   @default("#351a17")
  active      Boolean  @default(true)
  /// Límite propio de compra automática (€). Si es null se usa el general.
  purchaseAutoLimit Float?
  createdAt   DateTime @default(now())

  sessions          Session[]
  otpCodes          OtpCode[]
  shifts            Shift[]
  clockEvents       ClockEvent[]
  assignedTasks     Task[]             @relation("TaskAssignee")
  createdTasks      Task[]             @relation("TaskCreator")
  taskComments      TaskComment[]
  announcements     Announcement[]
  announcementReads AnnouncementRead[]
  incidents         Incident[]         @relation("IncidentUser")
  reportedIncidents Incident[]         @relation("IncidentReporter")
  notifications     Notification[]
  aiMessages        AiMessage[]
  auditLogs         AuditLog[]
  responsibleEvents AgendaEvent[]      @relation("EventResponsible")
  stockMovements    StockMovement[]
  createdOrders     PurchaseOrder[]    @relation("OrderCreator")
  approvedOrders    PurchaseOrder[]    @relation("OrderApprover")
  orderEvents       PurchaseOrderEvent[]
  chatMemberships   ConversationMember[]
  chatMessages      ChatMessage[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OtpCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Turno planificado. date = día de servicio (00:00 local), start/end en "HH:MM".
model Shift {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  start  String
  end    String
  note   String?

  @@unique([userId, date])
}

enum ClockType {
  ENTRADA
  SALIDA
  PAUSA_INICIO
  PAUSA_FIN
}

model ClockEvent {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ClockType
  at        DateTime  @default(now())
  note      String?
}

enum TaskKind {
  GENERAL
  PRODUCCION
  LIMPIEZA
  MANTENIMIENTO
  ADMINISTRATIVA
}

enum TaskStatus {
  PENDIENTE
  EN_CURSO
  COMPLETADA
}

enum Priority {
  BAJA
  MEDIA
  ALTA
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  kind        TaskKind   @default(GENERAL)
  area        Area?
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  date        DateTime?  @db.Date
  dueTime     String?
  priority    Priority   @default(MEDIA)
  status      TaskStatus @default(PENDIENTE)
  quantity    Float?
  unit        String?
  createdById String
  createdBy   User       @relation("TaskCreator", fields: [createdById], references: [id])
  createdByAi Boolean    @default(false)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  comments    TaskComment[]
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

enum AnnouncementLevel {
  URGENTE
  IMPORTANTE
  GENERAL
  INFORMATIVO
}

model Announcement {
  id          String             @id @default(cuid())
  title       String
  body        String
  level       AnnouncementLevel  @default(GENERAL)
  authorId    String
  author      User               @relation(fields: [authorId], references: [id])
  createdByAi Boolean            @default(false)
  createdAt   DateTime           @default(now())
  reads       AnnouncementRead[]
}

model AnnouncementRead {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([announcementId, userId])
}

enum IncidentType {
  RETRASO
  AUSENCIA
  CAMBIO_TURNO
  OTRO
}

model Incident {
  id           String       @id @default(cuid())
  type         IncidentType
  userId       String
  user         User         @relation("IncidentUser", fields: [userId], references: [id])
  date         DateTime     @db.Date
  minutes      Int?
  reason       String?
  /// Motivo privado: sólo lo ven el afectado y los responsables.
  reportedById String
  reportedBy   User         @relation("IncidentReporter", fields: [reportedById], references: [id])
  createdAt    DateTime     @default(now())
}

enum EventKind {
  ENTREGA
  RESERVA
  TAKEAWAY
  OTRO
}

/// Eventos de agenda que no son turnos ni tareas: entregas de proveedores,
/// reservas y pedidos para llevar (datos de prueba hasta las fases 2/3).
model AgendaEvent {
  id            String    @id @default(cuid())
  kind          EventKind
  title         String
  date          DateTime  @db.Date
  time          String
  people        Int?
  detail        String?
  responsibleId String?
  responsible   User?     @relation("EventResponsible", fields: [responsibleId], references: [id])
  /// Entrega generada por un pedido de compra confirmado
  purchaseOrderId String?   @unique
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  /// Texto visible en la conversación
  text      String
  /// Acciones ejecutadas por la IA en este turno (JSON para mostrar "qué hizo Pichuco")
  actions   Json?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  viaAi     Boolean  @default(false)
  action    String
  summary   String
  input     String?
  data      Json?
  createdAt DateTime @default(now())
}

// ─────────────────────────── Fase 2: stock, proveedores y compras

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactName   String?
  phone         String?
  whatsapp      String?
  email         String?
  /// Horario de atención, texto libre ("L–V 7:00–14:00")
  hours         String?
  /// Días de reparto: 0=domingo … 6=sábado
  deliveryDays  Int[]
  deliveryTime  String?
  minOrder      Float?
  conditions    String?
  /// Canal preferido para enviar pedidos: WHATSAPP, EMAIL, TELEFONO
  channel       String   @default("WHATSAPP")
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  products      Product[]
  orders        PurchaseOrder[]
}

model Product {
  id           String   @id @default(cuid())
  name         String
  category     String
  unit         String
  stock        Float    @default(0)
  minStock     Float    @default(0)
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  usualPrice   Float?
  lastPrice    Float?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  movements    StockMovement[]
  orderLines   PurchaseOrderLine[]
}

model StockMovement {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta      Float
  stockAfter Float
  /// ENTRADA_PEDIDO, AJUSTE, CONSUMO, MERMA
  reason     String
  note       String?
  unitPrice  Float?
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  orderId    String?
  createdAt  DateTime @default(now())
}

enum OrderStatus {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADO
  ENVIADO
  CONFIRMADO
  ENTREGADO
  CANCELADO
}

model PurchaseOrder {
  id            String      @id @default(cuid())
  number        Int         @unique @default(autoincrement())
  supplierId    String
  supplier      Supplier    @relation(fields: [supplierId], references: [id])
  status        OrderStatus @default(BORRADOR)
  total         Float       @default(0)
  /// Por qué necesita (o no) aprobación, para mostrarlo y auditarlo
  approvalNote  String?
  deliveryDate  DateTime?   @db.Date
  deliveryTime  String?
  notes         String?
  createdById   String
  createdBy     User        @relation("OrderCreator", fields: [createdById], references: [id])
  createdByAi   Boolean     @default(false)
  approvedById  String?
  approvedBy    User?       @relation("OrderApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  sentAt        DateTime?
  sentVia       String?
  confirmedAt   DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lines         PurchaseOrderLine[]
  events        PurchaseOrderEvent[]
  agendaEvent   AgendaEvent?
}

model PurchaseOrderLine {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Float
  unitPrice Float
}

/// Historial de cada pedido: quién hizo qué y cuándo.
model PurchaseOrderEvent {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  text      String
  viaAi     Boolean       @default(false)
  createdAt DateTime      @default(now())
}

/// Reglas de aprobación de compras (una sola fila, id = "default").
model PurchasePolicy {
  id                 String   @id @default("default")
  /// Hasta este importe la compra se aprueba sola
  autoLimit          Float    @default(100)
  /// Hasta este importe se pide aprobación al jefe; por encima es obligatoria y sólo desde la app
  managerLimit       Float    @default(300)
  /// Categorías que siempre requieren aprobación
  alwaysApprove      String[]
  updatedAt          DateTime @updatedAt
}

// ─────────────────────────── Fase 2: chat del equipo

model Conversation {
  id        String   @id @default(cuid())
  /// null en conversaciones 1 a 1
  name      String?
  isGroup   Boolean  @default(false)
  createdAt DateTime @default(now())
  lastMessageAt DateTime @default(now())
  members   ConversationMember[]
  messages  ChatMessage[]
}

model ConversationMember {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  body           String
  replyToId      String?
  replyTo        ChatMessage? @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[] @relation("Replies")
  attachment     ChatAttachment?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// Fotos y archivos del chat. Se guardan en la base para no depender de un
/// disco local (pensado para hosting sin almacenamiento persistente).
model ChatAttachment {
  id        String      @id @default(cuid())
  messageId String      @unique
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  size      Int
  data      Bytes
}

// ─────────────────────────── Fase 3: clientes, reservas y pedidos para llevar
// Datos de clientes separados de los internos: sólo se acceden con permisos
// de reservas / pedidos / clientes.

model Customer {
  id               String   @id @default(cuid())
  name             String
  /// Teléfono normalizado (sólo dígitos y +): identifica al cliente
  phone            String   @unique
  email            String?
  notes            String?
  /// Aceptó la política de privacidad (obligatorio para reservar/pedir online)
  privacyAcceptedAt DateTime?
  /// Acepta recibir novedades (opcional)
  marketingConsent Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  reservations     Reservation[]
  takeawayOrders   TakeawayOrder[]
}

enum ReservationStatus {
  CONFIRMADA
  SENTADA
  NO_SHOW
  CANCELADA
}

model Reservation {
  id          String            @id @default(cuid())
  /// Código público para que el cliente consulte o cancele
  code        String            @unique
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id])
  date        DateTime          @db.Date
  time        String
  people      Int
  notes       String?
  status      ReservationStatus @default(CONFIRMADA)
  /// WEB, TELEFONO, INTERNO
  source      String            @default("WEB")
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([date])
}

enum TakeawayStatus {
  NUEVO
  CONFIRMADO
  EN_PREPARACION
  LISTO
  RETIRADO
  CANCELADO
}

enum PaymentMethod {
  ONLINE
  AL_RECOGER
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  REEMBOLSADO
}

model TakeawayOrder {
  id            String         @id @default(cuid())
  number        Int            @unique @default(autoincrement())
  code          String         @unique
  customerId    String
  customer      Customer       @relation(fields: [customerId], references: [id])
  date          DateTime       @db.Date
  time          String
  status        TakeawayStatus @default(NUEVO)
  paymentMethod PaymentMethod  @default(AL_RECOGER)
  paymentStatus PaymentStatus  @default(PENDIENTE)
  /// Id de la sesión de pago (Stripe) o "demo"
  paymentRef    String?
  total         Float
  notes         String?
  source        String         @default("WEB")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lines         TakeawayLine[]

  @@index([date])
}

model TakeawayLine {
  id         String        @id @default(cuid())
  orderId    String
  order      TakeawayOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem?     @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  /// Copia del nombre y precio en el momento del pedido
  name       String
  quantity   Int
  unitPrice  Float
  /// Extras elegidos: [{ "name": "Extra muzza", "price": 2 }]
  extras     Json?
}

model MenuItem {
  id          String   @id @default(cuid())
  /// PIZZA, FAINA, EMPANADA, POSTRE, BEBIDA
  category    String
  name        String
  description String?
  price       Float
  /// Cuenta como pizza para la capacidad del horno y la previsión de masa
  isPizza     Boolean  @default(false)
  available   Boolean  @default(true)
  sort        Int      @default(0)
  lines       TakeawayLine[]
}

model MenuExtra {
  id        String  @id @default(cuid())
  name      String
  price     Float
  available Boolean @default(true)
  sort      Int     @default(0)
}

/// Configuración del restaurante (una fila, id = "default").
model RestaurantSettings {
  id                   String  @id @default("default")
  /// Días cerrado: 0=domingo … 6=sábado
  closedDays           Int[]
  /// Turnos de servicio "HH:MM-HH:MM" (último horario de reserva = fin)
  services             String[]
  /// Comensales máximos que pueden empezar en una misma franja de 30 min
  coversPerSlot        Int     @default(24)
  /// Personas máximas por reserva online (más: por teléfono)
  maxPartyOnline       Int     @default(8)
  /// Pizzas máximas para llevar por franja de 15 min
  takeawayPizzasPerSlot Int    @default(8)
  /// Minutos mínimos de antelación para pedidos para llevar
  takeawayLeadMinutes  Int     @default(30)
  /// Días hacia adelante que se puede reservar
  bookingDaysAhead     Int     @default(30)
  phone                String  @default("+34 930 000 000")
  address              String  @default("Barcelona")
  onlinePayments       Boolean @default(true)
}
