generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  /// Conexión directa para crear/actualizar tablas. En Supabase es la del
  /// "Session pooler" (puerto 5432); DATABASE_URL es la del "Transaction
  /// pooler" (puerto 6543, con ?pgbouncer=true). En local, las dos iguales.
  directUrl = env("DIRECT_URL")
}

enum Role {
  JEFE
  JEFE_COCINA
  COCINERO
  CAMARERA
}

enum Area {
  COCINA
  SALA
  ADMIN
  GENERAL
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  shortName   String
  role        Role
  area        Area     @default(GENERAL)
  avatarColor String   @default("#351a17")
  active      Boolean  @default(true)
  /// Teléfono de contacto (para que los proveedores avisen antes de venir)
  phone       String?
  /// Contraseña propia (scrypt). Null = todavía no la eligió: entra con el código del equipo.
  passwordHash  String?
  passwordSetAt DateTime?
  /// Límite propio de compra automática (€). Si es null se usa el general.
  purchaseAutoLimit Float?
  createdAt   DateTime @default(now())

  sessions          Session[]
  otpCodes          OtpCode[]
  shifts            Shift[]
  weeklyShifts      WeeklyShift[]
  clockEvents       ClockEvent[]
  assignedTasks     Task[]             @relation("TaskAssignee")
  createdTasks      Task[]             @relation("TaskCreator")
  taskComments      TaskComment[]
  announcements     Announcement[]
  announcementReads AnnouncementRead[]
  incidents         Incident[]         @relation("IncidentUser")
  reportedIncidents Incident[]         @relation("IncidentReporter")
  notifications     Notification[]
  aiMessages        AiMessage[]
  auditLogs         AuditLog[]
  responsibleEvents AgendaEvent[]      @relation("EventResponsible")
  stockMovements    StockMovement[]
  createdOrders     PurchaseOrder[]    @relation("OrderCreator")
  approvedOrders    PurchaseOrder[]    @relation("OrderApprover")
  callBeforeOrders  PurchaseOrder[]    @relation("OrderCallBefore")
  orderEvents       PurchaseOrderEvent[]
  chatMemberships   ConversationMember[]
  chatMessages      ChatMessage[]
  temperatureLogs   TemperatureLog[]
  receptionChecks   ReceptionCheck[]
  cleaningLogs      CleaningLog[]
  elaborations      Elaboration[]
  nonConformities   NonConformity[]   @relation("NcCreator")
  closedNcs         NonConformity[]   @relation("NcCloser")
  trainings         TrainingCert[]
  pestVisits        PestControlVisit[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OtpCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Turno planificado. date = día de servicio (00:00 local), start/end en "HH:MM".
model Shift {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  start  String
  end    String
  note   String?

  @@unique([userId, date])
}

/// Horario fijo semanal. Un `Shift` con fecha lo reemplaza ese día.
model WeeklyShift {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 0 = domingo … 6 = sábado
  weekday Int
  start   String
  end     String

  @@unique([userId, weekday])
}

enum ClockType {
  ENTRADA
  SALIDA
  PAUSA_INICIO
  PAUSA_FIN
}

model ClockEvent {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ClockType
  at        DateTime  @default(now())
  note      String?
}

enum TaskKind {
  GENERAL
  PRODUCCION
  LIMPIEZA
  MANTENIMIENTO
  ADMINISTRATIVA
}

enum TaskStatus {
  PENDIENTE
  EN_CURSO
  COMPLETADA
}

enum Priority {
  BAJA
  MEDIA
  ALTA
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  kind        TaskKind   @default(GENERAL)
  area        Area?
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  date        DateTime?  @db.Date
  dueTime     String?
  priority    Priority   @default(MEDIA)
  status      TaskStatus @default(PENDIENTE)
  quantity    Float?
  unit        String?
  createdById String
  createdBy   User       @relation("TaskCreator", fields: [createdById], references: [id])
  createdByAi Boolean    @default(false)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  comments    TaskComment[]
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

enum AnnouncementLevel {
  URGENTE
  IMPORTANTE
  GENERAL
  INFORMATIVO
}

model Announcement {
  id          String             @id @default(cuid())
  title       String
  body        String
  level       AnnouncementLevel  @default(GENERAL)
  authorId    String
  author      User               @relation(fields: [authorId], references: [id])
  createdByAi Boolean            @default(false)
  createdAt   DateTime           @default(now())
  reads       AnnouncementRead[]
}

model AnnouncementRead {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([announcementId, userId])
}

enum IncidentType {
  RETRASO
  AUSENCIA
  CAMBIO_TURNO
  OTRO
}

model Incident {
  id           String       @id @default(cuid())
  type         IncidentType
  userId       String
  user         User         @relation("IncidentUser", fields: [userId], references: [id])
  date         DateTime     @db.Date
  minutes      Int?
  reason       String?
  /// Motivo privado: sólo lo ven el afectado y los responsables.
  reportedById String
  reportedBy   User         @relation("IncidentReporter", fields: [reportedById], references: [id])
  createdAt    DateTime     @default(now())
}

enum EventKind {
  ENTREGA
  OTRO
}

/// Eventos de agenda que no son turnos ni tareas (entregas de proveedores…).
model AgendaEvent {
  id            String    @id @default(cuid())
  kind          EventKind
  title         String
  date          DateTime  @db.Date
  time          String
  /// Fin de la franja (entregas "entre 10:00 y 12:00")
  endTime       String?
  people        Int?
  detail        String?
  responsibleId String?
  responsible   User?     @relation("EventResponsible", fields: [responsibleId], references: [id])
  /// Entrega generada por un pedido de compra confirmado
  purchaseOrderId String?   @unique
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model AiMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  /// Texto visible en la conversación
  text      String
  /// Acciones ejecutadas por la IA en este turno (JSON para mostrar "qué hizo Pichuco")
  actions   Json?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  viaAi     Boolean  @default(false)
  action    String
  summary   String
  input     String?
  data      Json?
  createdAt DateTime @default(now())
}

// ─────────────────────────── Fase 2: stock, proveedores y compras

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactName   String?
  phone         String?
  whatsapp      String?
  email         String?
  /// Horario de atención, texto libre ("L–V 7:00–14:00")
  hours         String?
  /// Días de reparto: 0=domingo … 6=sábado
  deliveryDays  Int[]
  /// Franja habitual de entrega: desde deliveryTime hasta deliveryTimeTo
  deliveryTime  String?
  deliveryTimeTo String?
  minOrder      Float?
  conditions    String?
  /// Canal preferido para enviar pedidos: WHATSAPP, EMAIL, TELEFONO
  channel       String   @default("WHATSAPP")
  notes         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  products      Product[]
  orders        PurchaseOrder[]
}

model Product {
  id           String   @id @default(cuid())
  name         String
  category     String
  unit         String
  stock        Float    @default(0)
  minStock     Float    @default(0)
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  usualPrice   Float?
  lastPrice    Float?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  movements    StockMovement[]
  orderLines   PurchaseOrderLine[]
}

model StockMovement {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta      Float
  stockAfter Float
  /// ENTRADA_PEDIDO, AJUSTE, CONSUMO, MERMA
  reason     String
  note       String?
  unitPrice  Float?
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  orderId    String?
  createdAt  DateTime @default(now())
}

enum OrderStatus {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADO
  ENVIADO
  CONFIRMADO
  ENTREGADO
  CANCELADO
}

model PurchaseOrder {
  id            String      @id @default(cuid())
  number        Int         @unique @default(autoincrement())
  supplierId    String
  supplier      Supplier    @relation(fields: [supplierId], references: [id])
  status        OrderStatus @default(BORRADOR)
  total         Float       @default(0)
  /// Por qué necesita (o no) aprobación, para mostrarlo y auditarlo
  approvalNote  String?
  deliveryDate  DateTime?   @db.Date
  /// Franja de entrega: "entre deliveryTime y deliveryTimeTo"
  deliveryTime  String?
  deliveryTimeTo String?
  /// A quién tiene que llamar el proveedor antes de venir
  callBeforeId  String?
  callBefore    User?       @relation("OrderCallBefore", fields: [callBeforeId], references: [id])
  notes         String?
  createdById   String
  createdBy     User        @relation("OrderCreator", fields: [createdById], references: [id])
  createdByAi   Boolean     @default(false)
  approvedById  String?
  approvedBy    User?       @relation("OrderApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  sentAt        DateTime?
  sentVia       String?
  confirmedAt   DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lines         PurchaseOrderLine[]
  events        PurchaseOrderEvent[]
  agendaEvent   AgendaEvent?
}

model PurchaseOrderLine {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  quantity  Float
  unitPrice Float
}

/// Historial de cada pedido: quién hizo qué y cuándo.
model PurchaseOrderEvent {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  text      String
  viaAi     Boolean       @default(false)
  createdAt DateTime      @default(now())
}

/// Reglas de aprobación de compras (una sola fila, id = "default").
model PurchasePolicy {
  id                 String   @id @default("default")
  /// Hasta este importe la compra se aprueba sola
  autoLimit          Float    @default(100)
  /// Hasta este importe se pide aprobación al jefe; por encima es obligatoria y sólo desde la app
  managerLimit       Float    @default(300)
  /// Categorías que siempre requieren aprobación
  alwaysApprove      String[]
  updatedAt          DateTime @updatedAt
}

// ─────────────────────────── Fase 2: chat del equipo

model Conversation {
  id        String   @id @default(cuid())
  /// null en conversaciones 1 a 1
  name      String?
  isGroup   Boolean  @default(false)
  createdAt DateTime @default(now())
  lastMessageAt DateTime @default(now())
  members   ConversationMember[]
  messages  ChatMessage[]
}

model ConversationMember {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id])
  body           String
  replyToId      String?
  replyTo        ChatMessage? @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[] @relation("Replies")
  attachment     ChatAttachment?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// Fotos y archivos del chat. Se guardan en la base para no depender de un
/// disco local (pensado para hosting sin almacenamiento persistente).
model ChatAttachment {
  id        String      @id @default(cuid())
  messageId String      @unique
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  size      Int
  data      Bytes
}

// ─────────────────────────── Controles sanitarios (APPCC)

/// Cámaras, congeladores y neveras con su rango de temperatura válido.
model FoodEquipment {
  id           String   @id @default(cuid())
  name         String
  /// REFRIGERACION, CONGELACION, CALIENTE
  kind         String
  minTemp      Float
  maxTemp      Float
  /// Lecturas por día: 2 = apertura y cierre
  checksPerDay Int      @default(2)
  area         String   @default("COCINA")
  active       Boolean  @default(true)
  sort         Int      @default(0)
  logs         TemperatureLog[]
}

model TemperatureLog {
  id               String        @id @default(cuid())
  equipmentId      String
  equipment        FoodEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  value            Float
  outOfRange       Boolean       @default(false)
  correctiveAction String?
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  viaAi            Boolean       @default(false)
  at               DateTime      @default(now())

  @@index([equipmentId, at])
}

/// Control de mercancía al recibirla.
model ReceptionCheck {
  id              String   @id @default(cuid())
  supplierId      String?
  supplierName    String
  product         String
  temperature     Float?
  packagingOk     Boolean  @default(true)
  labelOk         Boolean  @default(true)
  expiryDate      DateTime? @db.Date
  lot             String?
  accepted        Boolean  @default(true)
  notes           String?
  purchaseOrderId String?
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  at              DateTime @default(now())
}

/// Plan de limpieza y desinfección.
model CleaningItem {
  id        String   @id @default(cuid())
  name      String
  area      String
  /// DIARIA, SEMANAL, MENSUAL
  frequency String
  /// Producto y método ("Desengrasante, aclarar y secar")
  method    String?
  active    Boolean  @default(true)
  sort      Int      @default(0)
  logs      CleaningLog[]
}

model CleaningLog {
  id     String       @id @default(cuid())
  itemId String
  item   CleaningItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id])
  notes  String?
  viaAi  Boolean      @default(false)
  at     DateTime     @default(now())

  @@index([itemId, at])
}

/// Tipos de elaboración con su vida útil (para calcular la caducidad).
model ElaborationType {
  id            String   @id @default(cuid())
  name          String
  shelfLifeDays Int
  /// REFRIGERADO, CONGELADO, AMBIENTE
  storage       String   @default("REFRIGERADO")
  allergens     String[]
  unit          String   @default("kg")
  active        Boolean  @default(true)
  elaborations  Elaboration[]
}

/// Trazabilidad de elaboraciones propias: lote, fecha y caducidad (etiqueta).
model Elaboration {
  id         String           @id @default(cuid())
  lot        String           @unique
  typeId     String?
  type       ElaborationType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  name       String
  quantity   Float?
  unit       String?
  storage    String
  allergens  String[]
  madeAt     DateTime         @default(now())
  expiresAt  DateTime
  /// EN_USO, CONSUMIDO, DESECHADO
  status     String           @default("EN_USO")
  discardReason String?
  userId     String
  user       User             @relation(fields: [userId], references: [id])
  viaAi      Boolean          @default(false)

  @@index([status, expiresAt])
}

/// Platos de la carta con sus alérgenos (Reglamento UE 1169/2011).
model Dish {
  id        String   @id @default(cuid())
  name      String
  category  String
  allergens String[]
  /// Puede contener trazas de…
  traces    String[]
  active    Boolean  @default(true)
  sort      Int      @default(0)
  updatedAt DateTime @updatedAt
}

model PestControlVisit {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  company   String
  /// REVISION, TRATAMIENTO, INCIDENCIA
  kind      String
  notes     String?
  nextVisit DateTime? @db.Date
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

/// Formación de manipuladores de alimentos.
model TrainingCert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  provider  String?
  issuedAt  DateTime @db.Date
  expiresAt DateTime? @db.Date
  createdAt DateTime @default(now())
}

/// No conformidades con su acción correctora.
model NonConformity {
  id               String    @id @default(cuid())
  /// TEMPERATURA, RECEPCION, LIMPIEZA, ELABORACION, PLAGAS, OTRO
  source           String
  description      String
  correctiveAction String?
  /// ABIERTA, CERRADA
  status           String    @default("ABIERTA")
  relatedId        String?
  createdById      String
  createdBy        User      @relation("NcCreator", fields: [createdById], references: [id])
  closedById       String?
  closedBy         User?     @relation("NcCloser", fields: [closedById], references: [id])
  closedAt         DateTime?
  viaAi            Boolean   @default(false)
  createdAt        DateTime  @default(now())
}

/// Marcas de tareas de mantenimiento que se hacen una sola vez (p. ej. borrar los datos de prueba).
model AppFlag {
  key String   @id
  at  DateTime @default(now())
}
